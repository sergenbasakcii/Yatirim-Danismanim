# ─────────────────────────────────────────────────────────────────────────
# HedgeFund AI — Streamlit Secrets (Example)
# ─────────────────────────────────────────────────────────────────────────
# Copy this file to `.streamlit/secrets.toml` and fill in real values.
# `secrets.toml` is GIT-IGNORED — never commit real keys.
#
# On Streamlit Community Cloud: paste these values under
# "App settings → Secrets" in the dashboard (same TOML format).
# ─────────────────────────────────────────────────────────────────────────

# ── SMTP — required for email verification & password reset codes ─────
# Recommended free option: Gmail with an App Password
#   1. Enable 2-Step Verification at https://myaccount.google.com/security
#   2. Create an App Password at https://myaccount.google.com/apppasswords
#   3. Use that 16-char password (NOT your Gmail password) as `password`.
#
# Alternative free providers: Brevo (300 mails/day), Resend (3000/mo).
[smtp]
host     = "smtp.gmail.com"
port     = 587
user     = "your.address@gmail.com"
password = "abcd efgh ijkl mnop"     # Gmail App Password (16 chars, spaces OK)
from     = "your.address@gmail.com"  # usually same as user

# ── External API keys (move out of config/settings.yaml) ──────────────
# These are overlaid on settings.yaml at runtime by src/config_loader.py.
# Env-var equivalents: HFAI_API_KEYS_<KEY_UPPER>
[api_keys]
binance_api_key = ""
binance_secret  = ""
finnhub         = ""
newsapi         = ""
fred            = ""
glassnode       = ""

# ── Telegram bot (optional) ───────────────────────────────────────────
# Env-var equivalents: HFAI_TELEGRAM_BOT_TOKEN / HFAI_TELEGRAM_CHAT_ID
[telegram]
bot_token = ""
chat_id   = ""

# ── Alert SMTP (optional, separate from auth SMTP above) ──────────────
# Env-var equivalents: HFAI_ALERTS_SMTP_HOST / _SMTP_PORT / _SMTP_USER /
#                      _SMTP_PASS / _ALERT_EMAIL
[alerts]
smtp_host   = ""
smtp_port   = 587
smtp_user   = ""
smtp_pass   = ""
alert_email = ""

# ── AI commentary (FREE) ──────────────────────────────────────────────
# Powers the natural-language market/analysis commentary.
# Default provider: Google Gemini Flash — genuinely FREE tier,
# no credit card, hard rate limits (no overage billing).
#   1. Open https://aistudio.google.com/apikey
#   2. Sign in with Google → "Create API key"
#   3. Paste the key below (or set env var GEMINI_API_KEY)
# If left empty, the app silently falls back to the built-in static
# commentary — nothing breaks, no cost ever.
[ai]
gemini_key = ""
